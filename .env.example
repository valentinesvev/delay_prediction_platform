# Одна база для телеметрии, плана и прогнозов. .env автоматически не загружается.
# Локальная проверка: sqlite:///artifacts/demo.db
DATABASE_URL=sqlite:///artifacts/demo.db
ML_TIME_MODE=stream
ML_INTERVAL_S=30
ML_WINDOW_S=2700
MODEL_TYPE=ensemble
PREDICTION_MAX_AGE_SECONDS=90
PORT=8000
NDTP_HOST=0.0.0.0
NDTP_PORT=9000
EMULATOR_API_PORT=18080
# NDTP_UNIT_MAP=/absolute/path/to/units.json
CLEANUP_INTERVAL_S=600
TELEMETRY_RETENTION_S=7200
SCHEDULE_RETENTION_S=21600
PREDICTIONS_RETENTION_S=86400

# Для живого потока переключить ML_TIME_MODE=wall.
# Имена таблиц и колонок при необходимости настраиваются в ml/db.py (DBConfig).
# Очистка работает при запущенном ndtp_ingestion.server.
