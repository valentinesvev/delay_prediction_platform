# Два постоянных файла. .env автоматически не загружается.
DATABASE_URL=sqlite:///artifacts/input.db
RESULTS_DATABASE_URL=sqlite:///artifacts/results.db
DATA_TIME_MODE=stream
# Docker historical включает воспроизведение автоматически.
# Локально: python scripts/run_demo.py --replay
# REPLAY_STATE_DIR=/absolute/path/to/artifacts/replay-clock
REPLAY_STEP_S=10
REPLAY_TICK_S=1
ANALYTICS_INTERVAL_S=30
ANALYTICS_CORRIDOR_M=150
ANALYTICS_ACTIVE_S=120
ANALYTICS_RECENT_S=600
ANALYTICS_SLOWDOWN_RATIO=1.4
ANALYTICS_MIN_BASELINE_N=3
ANALYTICS_MIN_CONFIRMING=2
# ML_TIME_MODE=stream  # прежнее имя; используется только без DATA_TIME_MODE
ML_INTERVAL_S=30
ML_WINDOW_S=2700
MODEL_TYPE=ensemble
PREDICTION_MAX_AGE_SECONDS=90
PORT=8000
NDTP_HOST=0.0.0.0
NDTP_PORT=9000
EMULATOR_API_PORT=18080
# NDTP_UNIT_MAP=/absolute/path/to/units.json
CLEANUP_INTERVAL_S=600
TELEMETRY_RETENTION_S=7200
SCHEDULE_RETENTION_S=21600
PREDICTIONS_RETENTION_S=86400
RESULTS_CLEANUP_INTERVAL_S=600

# Для живого потока переключить DATA_TIME_MODE=wall.
# Имена таблиц и колонок при необходимости настраиваются в ml/db.py (DBConfig).
# Входные данные очищает ndtp_ingestion.server.
# Все таблицы результатов очищает maintenance.results, только в режиме wall.

# Единый режим времени для всех процессов: stream или wall.
# Если DATA_TIME_MODE отсутствует, используется прежний ML_TIME_MODE.
# Независимое обслуживание ВСЕХ таблиц результатов: python -m maintenance.results
VEHICLE_STATE_RETENTION_S=86400
SEGMENT_PASSAGES_RETENTION_S=2592000
SEGMENT_BASELINE_RETENTION_S=2592000
SEGMENT_STATE_RETENTION_S=86400
ALERTS_RETENTION_S=604800
# Интервалы каждой таблицы по умолчанию равны RESULTS_CLEANUP_INTERVAL_S.
# Примеры независимого расписания (раскомментируйте нужные):
# PREDICTIONS_CLEANUP_INTERVAL_S=600
# VEHICLE_STATE_CLEANUP_INTERVAL_S=600
# SEGMENT_PASSAGES_CLEANUP_INTERVAL_S=3600
# SEGMENT_BASELINE_CLEANUP_INTERVAL_S=3600
# SEGMENT_STATE_CLEANUP_INTERVAL_S=600
# ALERTS_CLEANUP_INTERVAL_S=600
