# Одна база для телеметрии, плана и прогнозов. .env автоматически не загружается.
# Локальная проверка: sqlite:///artifacts/demo.db
DATABASE_URL=sqlite:///artifacts/demo.db
ML_TIME_MODE=stream
ML_INTERVAL_S=30
ML_WINDOW_S=2700
MODEL_TYPE=ensemble
PREDICTION_MAX_AGE_SECONDS=90
PORT=8000

# Для живого потока переключить ML_TIME_MODE=wall.
# Имена таблиц и колонок при необходимости настраиваются в ml/db.py (DBConfig).
# Сроки хранения/очистка принадлежат будущему обработчику входа.
