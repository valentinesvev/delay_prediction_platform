# Пример переменных окружения. .env автоматически не загружается.
# Перед запуском: set -a; source .env; set +a
INPUT_INTERVAL_SECONDS=1
PREDICTION_INTERVAL_SECONDS=3
INPUT_RETENTION_SECONDS=1800
RESULT_RETENTION_SECONDS=1800
PREDICTION_MAX_AGE_SECONDS=15
PORT=8000
# DEMO_DATA_DIR=/absolute/path/to/demo/databases

# baseline, catboost или torch. Пока модели не подключены, используется baseline.
MODEL_TYPE=baseline
